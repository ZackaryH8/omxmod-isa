{
  "id": "intelligent-speed-assistance",
  "name": "Intelligent Speed Assistance",
  "version": "1.0.2",
  "apiVersion": "2.1",
  "permissions": [ "vehicle.control", "ui.hud", "storage" ],
  "configuration": {
    "enabled": true,
    "speedUnit": "mph",
    "approachBandKmh": 1.5,
